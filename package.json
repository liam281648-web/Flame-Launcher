{
  "name": "flame-client",
  "productName": "Flame Client",
  "version": "0.1.0",
  "private": true,
  "description": "A modern, sleek Minecraft client launcher.",
  "main": "dist/main/main.js",
  "author": "Flame",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "concurrently -k -n renderer,main,app -c cyan,magenta,green \"npm:dev:renderer\" \"npm:dev:main\" \"npm:dev:app\"",
    "dev:renderer": "vite",
    "dev:main": "node scripts/build-main.mjs --watch",
    "dev:app": "wait-on tcp:127.0.0.1:5173 && node scripts/run-electron.mjs",
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run typecheck && npm run build:main && npm run build:renderer",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node scripts/run-tests.mjs",
    "test:store": "node scripts/build-store-probe.mjs && node scripts/test-store.mjs",
    "test:instances": "node scripts/build-instances-probe.mjs && node scripts/test-instances.mjs",
    "test:api": "node scripts/build-packs-probe.mjs && node scripts/test-modrinth.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "test:import": "node scripts/build-importer-probe.mjs && node scripts/test-importer.mjs",
    "test:updater": "node scripts/build-updater-probe.mjs && node scripts/test-updater.mjs",
    "test:quick": "npm run typecheck && npm run test:store && npm run test:instances",
    "start": "electron .",
    "dist": "npm run build && electron-builder --win",
    "dist:dir": "npm run build && electron-builder --win --dir",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.49.0",
    "msmc": "^5.0.5",
    "pngjs": "^7.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^26.6.3",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^10.0.5",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.flame.client",
    "productName": "Flame Client",
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "liam281648-web",
      "repo": "Flame-Launcher",
      "releaseType": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "!dist/**/*-probe.mjs",
      "!dist/test-sandbox/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
